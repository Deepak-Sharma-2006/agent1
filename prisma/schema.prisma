// DealFlow360 - Declarative Relational Persistence Schema
// Phase 3: Serverless Local SQL Persistence Layer (SQLite + Prisma ORM)
// Database Engine: SQLite (file:./dev.db)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// -----------------------------------------------------------------------------
// Customer & Enterprise Accounts
// -----------------------------------------------------------------------------
model Customer {
  id                    String      @id @default(uuid())
  name                  String
  email                 String      @unique
  tier                  String      @default("Bronze") // Bronze, Silver, Gold, Platinum
  annualSpendCents      Int         @default(0)
  dsoDays               Int         @default(30)
  overdueDays           Int         @default(0)
  maxOverdueDays        Int         @default(0)
  cadenceOrders90d      Int         @default(0)
  trailing90dSpendCents Int         @default(0)
  trailing180dSpendCents Int        @default(0)
  trailing365dSpendCents Int        @default(0)
  defaultRate           Float       @default(0.0)
  creditLimitCents      Int         @default(1000000) // $10,000.00
  paymentTerms          String      @default("Net30")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  quotations            Quotation[]

  @@index([tier])
  @@index([email])
}

model CustomerPriceList {
  id                     String   @id @default(uuid())
  tier                   String   // Bronze, Silver, Gold, Platinum
  category               String   // Hardware, Service, Subscription
  defaultDiscountPercent Float    @default(0.0)
  active                 Boolean  @default(true)

  @@unique([tier, category])
}

// -----------------------------------------------------------------------------
// Catalog Products & Variants
// -----------------------------------------------------------------------------
model Product {
  id               String           @id @default(uuid())
  sku              String           @unique
  name             String
  category         String           // Hardware, Service, Subscription
  listPriceCents   Int
  costPriceCents   Int
  isSubscription   Boolean          @default(false)
  billingFrequency String?          // Monthly, Quarterly, Annual
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variants         ProductVariant[]
  inventory        StockInventory[]
  lines            QuotationLine[]

  @@index([category])
  @@index([sku])
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  sku            String   @unique
  name           String
  priceDeltaCents Int     @default(0)
  costDeltaCents  Int     @default(0)
  attributesJson String   @default("{}")

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// -----------------------------------------------------------------------------
// Warehouses & Distributed Inventory
// -----------------------------------------------------------------------------
model Warehouse {
  id            String           @id @default(uuid())
  code          String           @unique
  name          String
  city          String
  state         String
  country       String           @default("USA")
  isPrimaryHub  Boolean          @default(false)
  active        Boolean          @default(true)
  capacityUnits Int              @default(50000)

  inventory     StockInventory[]
  shipments     ShipmentOrder[]

  @@index([code])
}

model StockInventory {
  id            String    @id @default(uuid())
  productId     String
  warehouseId   String
  physicalStock Int       @default(0)
  reservedStock Int       @default(0)
  safetyBuffer  Int       @default(10)
  reorderPoint  Int       @default(20)
  updatedAt     DateTime  @updatedAt

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// -----------------------------------------------------------------------------
// Pricing & Incentive Governance Rules
// -----------------------------------------------------------------------------
model DiscountRule {
  id                 String   @id @default(uuid())
  ruleType           String   // CustomerTierCeiling, CategoryCeiling
  targetType         String   // Tier, Category
  targetId           String   // Bronze, Silver, Gold, Hardware, Service, Subscription
  maxDiscountPercent Float
  minMarginPercent   Float    @default(18.0)
  active             Boolean  @default(true)

  @@unique([ruleType, targetType, targetId])
}

model IncentiveRule {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  description     String
  ruleType        String   // VolumeSpike, MilestoneLoyalty, CareBundle
  parametersJson  String   @default("{}")
  discountPercent Float    @default(0.0)
  rebateCents     Int      @default(0)
  active          Boolean  @default(true)

  @@index([code])
}

// -----------------------------------------------------------------------------
// Quotation Lifecycle & Optimistic Concurrency Control (OCC)
// -----------------------------------------------------------------------------
model Quotation {
  id                      String                     @id @default(uuid())
  quoteNumber             String                     @unique
  customerId              String
  salesRepId              String                     @default("rep-001")
  status                  String                     @default("Draft") // Draft, PendingApproval, Approved, Sent, UnderNegotiation, Confirmed, Cancelled
  version                 Int                        @default(1) // OCC Version Clock
  subtotalCents           Int                        @default(0)
  discountAmountCents     Int                        @default(0)
  taxAmountCents          Int                        @default(0)
  netTotalCents           Int                        @default(0)
  totalCostCents          Int                        @default(0)
  grossMarginPercent      Float                      @default(0.0)
  blendedRiskScore        Float                      @default(0.0)
  requiresManagerApproval Boolean                    @default(false)
  requiresFinanceApproval Boolean                    @default(false)
  fallbackSnapshotJson    String?
  notes                   String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  customer                Customer                   @relation(fields: [customerId], references: [id])
  lines                   QuotationLine[]
  approvalSnapshots       VersionedApprovalSnapshot[]
  shipments               ShipmentOrder[]
  negotiationMessages     NegotiationMessage[]

  @@index([customerId])
  @@index([status])
  @@index([quoteNumber])
}

model QuotationLine {
  id              String    @id @default(uuid())
  quotationId     String
  productId       String
  quantity        Int       @default(1)
  listPriceCents  Int
  costPriceCents  Int
  discountPercent Float     @default(0.0)
  netPriceCents   Int
  totalNetCents   Int
  totalCostCents  Int
  marginPercent   Float     @default(0.0)
  lineRiskScore   Float     @default(0.0)
  comments        String?

  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
}

model VersionedApprovalSnapshot {
  id                     String    @id @default(uuid())
  quotationId            String
  version                Int
  approverRole           String    // SalesManager, Finance
  approverId             String
  status                 String    // Approved, Rejected
  approvedDiscountPercent Float    @default(0.0)
  approvedIncentiveCents Int       @default(0)
  snapshotPayloadJson    String    // Full quotation state serialized for Graceful Fallback
  approvedAt             DateTime  @default(now())

  quotation              Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([version])
}

// -----------------------------------------------------------------------------
// Phase 8: Multi-Warehouse Split Fulfillment Engine
// -----------------------------------------------------------------------------
model ShipmentOrder {
  id             String         @id @default(uuid())
  quotationId    String
  warehouseId    String
  trackingNumber String?
  carrier        String?        // FedEx, UPS, FreightDirect
  status         String         @default("Placed") // Placed, Processing, Shipped, Delivered
  shippedAt      DateTime?
  createdAt      DateTime       @default(now())

  quotation      Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  items          ShipmentItem[]

  @@index([quotationId])
  @@index([warehouseId])
  @@index([status])
}

model ShipmentItem {
  id              String        @id @default(uuid())
  shipmentOrderId String
  quotationLineId String
  quantity        Int

  shipmentOrder   ShipmentOrder @relation(fields: [shipmentOrderId], references: [id], onDelete: Cascade)

  @@index([shipmentOrderId])
}

model BackorderTicket {
  id          String    @id @default(uuid())
  quotationId String
  productId   String
  quantity    Int
  status      String    @default("Pending") // Pending, Replenished, Consolidated
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([quotationId])
  @@index([productId])
}

// -----------------------------------------------------------------------------
// Phase 7: Customer Portal Negotiation Timeline
// -----------------------------------------------------------------------------
model NegotiationMessage {
  id                     String    @id @default(uuid())
  quotationId            String
  senderRole             String    // Customer, SalesRep, SalesManager, Finance
  senderName             String
  proposedDiscountPercent Float?
  messageText            String
  createdAt              DateTime  @default(now())

  quotation              Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// -----------------------------------------------------------------------------
// Immutable Event Audit Ledger (Phase 4 WebSocket Egress & Compliance)
// -----------------------------------------------------------------------------
model AuditLog {
  id            String   @id @default(uuid())
  aggregateType String   // Quotation, Customer, Inventory, Rule
  aggregateId   String
  eventType     String   // QuoteCreated, DiscountApproved, FallbackReverted, StockAllocated
  payloadJson   String
  actorId       String
  actorRole     String
  createdAt     DateTime @default(now())

  @@index([aggregateType, aggregateId])
  @@index([eventType])
}
