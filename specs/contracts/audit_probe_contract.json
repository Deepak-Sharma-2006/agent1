{
  "feature_name": "audit_probe",
  "fsm_states": [
    "IDLE",
    "RUNNING",
    "COMPLETED",
    "FAILED",
    "CERTIFIED"
  ],
  "fsm_transitions": [
    {
      "from": "IDLE",
      "to": "RUNNING",
      "trigger": "START_JOB"
    },
    {
      "from": "RUNNING",
      "to": "COMPLETED",
      "trigger": "EXECUTION_SUCCESS"
    },
    {
      "from": "RUNNING",
      "to": "FAILED",
      "trigger": "EXECUTION_ERROR"
    },
    {
      "from": "COMPLETED",
      "to": "CERTIFIED",
      "trigger": "AUDIT_SIGN_OFF"
    }
  ],
  "data_schemas": {
    "CaseState": {
      "case_id": "string",
      "status": "enum(IDLE, RUNNING, COMPLETED, FAILED, CERTIFIED)",
      "calculated_confidence": "float (0.0 to 1.0)",
      "evidence_nodes": "list[string]",
      "updated_at": "ISO-8601 string"
    }
  },
  "api_endpoints": [
    {
      "path": "/api/status",
      "method": "GET",
      "response": "CaseState"
    },
    {
      "path": "/api/execute",
      "method": "POST",
      "response": "JobReceipt"
    }
  ]
}