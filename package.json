{
  "name": "antigravity-enterprise-workflow",
  "version": "1.0.0",
  "description": "Enterprise 2-Person / 2-Computer Shared Context Autonomous Agentic Workflow",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:alpha": "node --experimental-strip-types scripts/alpha-builder-runner.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "test:unit": "node --experimental-strip-types --test tests/bootstrap.test.ts",
    "test": "npm run test:unit && npm run harness:eval",
    "role:status": "node --experimental-strip-types scripts/role-switch.ts status",
    "role:alpha": "node --experimental-strip-types scripts/role-switch.ts alpha",
    "role:beta": "node --experimental-strip-types scripts/role-switch.ts beta",
    "role:handoff": "node --experimental-strip-types scripts/role-switch.ts handoff",
    "role:transfer": "node --experimental-strip-types scripts/lock-manager.ts transfer",
    "role:release": "node --experimental-strip-types scripts/lock-manager.ts release",
    "lock:status": "node --experimental-strip-types scripts/lock-manager.ts status",
    "lock:acquire": "node --experimental-strip-types scripts/lock-manager.ts acquire",
    "lock:heartbeat": "node --experimental-strip-types scripts/lock-manager.ts heartbeat",
    "lock:transfer": "node --experimental-strip-types scripts/lock-manager.ts transfer",
    "lock:release": "node --experimental-strip-types scripts/lock-manager.ts release",
    "audit:beta": "node --experimental-strip-types scripts/beta-audit-runner.ts",
    "cleanproduction:status": "node --experimental-strip-types scripts/clean-production-sync.ts status",
    "cleanproduction:set-remote": "node --experimental-strip-types scripts/clean-production-sync.ts set-remote",
    "cleanproduction:publish": "node --experimental-strip-types scripts/clean-production-sync.ts publish",
    "prod:status": "npm run cleanproduction:status",
    "prod:publish": "npm run cleanproduction:publish",
    "memory:save": "node --experimental-strip-types scripts/memory-vault.ts save",
    "memory:search": "node --experimental-strip-types scripts/memory-vault.ts search",
    "memory:doctor": "node --experimental-strip-types scripts/memory-vault.ts doctor",
    "pentest": "node --experimental-strip-types scripts/pen-test-runner.ts",
    "strix:help": "strix --help",
    "strix:quick": "strix -m quick --non-interactive -t .",
    "strix:deep": "strix -m deep --non-interactive -t .",
    "check:secrets": "node --experimental-strip-types scripts/secret-scanner.ts",
    "check:secrets:staged": "node --experimental-strip-types scripts/secret-scanner.ts --staged",
    "hooks:install": "node --experimental-strip-types scripts/install-hooks.ts",
    "check:hallucinations": "node --experimental-strip-types scripts/anti-hallucination-checker.ts scripts src tests",
    "token:budget": "node --experimental-strip-types scripts/token-budget-guard.ts status",
    "token:status": "node --experimental-strip-types scripts/token-budget-guard.ts status",
    "token:models": "node --experimental-strip-types scripts/token-budget-guard.ts models",
    "token:set-model": "node --experimental-strip-types scripts/token-budget-guard.ts set-model",
    "token:record": "node --experimental-strip-types scripts/token-budget-guard.ts record",
    "harness:eval": "node --experimental-strip-types .agents/harness/eval-runner.ts",
    "readiness": "node --experimental-strip-types scripts/system-readiness.ts",
    "readiness:check": "node --experimental-strip-types scripts/system-readiness.ts",
    "skill:list": "node --experimental-strip-types scripts/skill-finder.ts list",
    "skill:search": "node --experimental-strip-types scripts/skill-finder.ts search",
    "skill:view": "node --experimental-strip-types scripts/skill-finder.ts view",
    "skill:create": "node --experimental-strip-types scripts/skill-creator.ts",
    "skill:synthesize": "node --experimental-strip-types scripts/skill-creator.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
